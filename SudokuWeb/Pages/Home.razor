@page "/"
@implements IDisposable
@inject PlayerData Data
@inject BrowserInterop Browser

@if (!loaded)
{
    <div class="loading-screen"><div class="spinner"></div></div>
}
else
{
    <div class="app" tabindex="0" @onkeydown="OnKeyDown">
        <header>
            <h1><span class="heart">💜</span> Leanas Sudoku</h1>
            <button class="streak-chip @(DoneToday ? "done" : "")" aria-label="Tägliches Rätsel und Serie" @onclick="() => sheet = Sheets.Daily">
                <span class="flame">🔥</span><b>@Streak</b>
                @if (!DoneToday)
                {
                    <i class="dot" title="Heutiges Rätsel noch offen"></i>
                }
            </button>
        </header>

        <div class="infobar">
            <GameClock Game="game" Paused="Paused" OnAutoSave="SaveGame" />
            <div class="status @StatusClass">@StatusText</div>
            <button class="icon-btn" aria-label="Statistik" @onclick="() => sheet = Sheets.Stats">
                <svg viewBox="0 0 24 24"><path d="M5 20V11M12 20V4M19 20v-6"/></svg>
            </button>
            <button class="icon-btn" aria-label="Hell/Dunkel umschalten" @onclick="ToggleTheme">
                @if (theme == "dark")
                {
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24"><path d="M21 13A9 9 0 1 1 11 3a7 7 0 0 0 10 10z"/></svg>
                }
            </button>
            <button class="icon-btn accent" aria-label="Neues Spiel" @onclick="() => sheet = Sheets.NewGame">
                <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
            </button>
        </div>

        <Board Game="game" />
        <Controls Game="game" OnChanged="OnGameChanged" />
    </div>

    @switch (sheet)
    {
        case Sheets.NewGame:
            <NewGameSheet DailyText="@DailyCardText" ResumeFreeText="@ResumeFreeText"
                          FreeInProgress="session.FreeGameInProgress" FreeProgressText="@FreeProgressText"
                          OnStart="StartNewGame" OnDaily="() => sheet = Sheets.Daily"
                          OnResumeFree="ResumeFree" OnClose="CloseSheet" />
            break;
        case Sheets.Daily:
            <DailySheet Progress="Data.Daily" Today="today" Resumable="session.DailyResumable(today)"
                        SwitchedAway="session.ActiveSlot == GameSlot.Free && game.InProgress"
                        OnStartDaily="StartDaily" OnClose="CloseSheet" />
            break;
        case Sheets.Stats:
            <StatsSheet Stats="Data.Stats" Daily="Data.Daily" OnClose="CloseSheet" />
            break;
    }

    @if (showWin)
    {
        <WinDialog Game="game" NewRecord="newRecord" DailyStreak="dailyStreakAfterWin"
                   OnNewGame="OpenNewGameFromWin" OnClose="() => showWin = false" />
    }
}

@code {
    private enum Sheets { None, NewGame, Daily, Stats }

    private GameSession session = default!;
    private SudokuGame game => session.Game;
    private DotNetObjectReference<Home>? selfReference;

    private bool loaded;
    private DateOnly today;
    private string theme = "light";
    private Sheets sheet = Sheets.None;

    private bool showWin;
    private bool newRecord;
    private int? dailyStreakAfterWin;

    private bool Paused => sheet != Sheets.None || showWin;
    private int Streak => Data.Daily.CurrentStreak(today);
    private bool DoneToday => Data.Daily.IsSolved(today);

    private string DailyCardText => DoneToday ? "Heute schon geschafft ✓"
        : session.DailyResumable(today) ? "Weiterspielen"
        : "Jeden Tag ein neues – halte deine Serie!";

    private string? ResumeFreeText => session.ParkedFreeGame is { } parked
        ? $"{parked.Difficulty.Emoji()} {parked.Difficulty} · {GameText.Time(parked.Seconds)}"
        : null;

    private string FreeProgressText => session.SavedFor(GameSlot.Free) is { } free
        ? $"{free.Difficulty} · {GameText.Time(free.Seconds)}"
        : "";

    private string StatusClass => game.LastCheckErrors is int errors && !game.Solved ? (errors == 0 ? "ok" : "bad") : "";

    private string StatusText
    {
        get
        {
            if (game.LastCheckErrors is int errors && !game.Solved)
                return errors == 0 ? "✓ Bisher alles richtig" : $"✗ {errors} {(errors == 1 ? "Feld" : "Felder")} falsch";

            if (game.DailyDate is { } day)
                return day == today ? $"Täglich · {game.Difficulty}" : $"Täglich {day.Short()} · {game.Difficulty}";

            return $"{game.Difficulty.Emoji()} {game.Difficulty}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Data.LoadAsync();
        today = await Browser.GetTodayAsync();
        theme = await Browser.GetThemeAsync();

        // Spielstände von der letzten Sitzung fortsetzen (die iPhone-App wird oft vom System beendet).
        session = new GameSession(Data.Stats, Data.Daily);
        var (free, daily, active) = await Data.LoadSlotsAsync();
        session.Initialize(free, daily, active);
        await AfterGameChanged();

        selfReference = DotNetObjectReference.Create(this);
        await Browser.ListenForVisibilityAsync(selfReference);
        loaded = true;
    }

    /// <summary>Vom Browser aufgerufen, wenn die App in den Hintergrund geht oder zurückkommt.</summary>
    [JSInvokable]
    public async Task OnVisibilityChanged(bool hidden)
    {
        if (hidden)
        {
            await SaveGame();
            return;
        }

        // Zurück in der App: vielleicht ist inzwischen ein neuer Tag.
        today = await Browser.GetTodayAsync();
        StateHasChanged();
    }

    // ---- Spielablauf -------------------------------------------------------

    private async Task StartNewGame(Difficulty difficulty)
    {
        session.StartFree(difficulty);
        await AfterGameChanged();
    }

    private async Task StartDaily()
    {
        today = await Browser.GetTodayAsync();
        if (session.StartOrResumeDaily(today))
            await AfterGameChanged();
    }

    private async Task ResumeFree()
    {
        if (session.ResumeFree())
            await AfterGameChanged();
    }

    // Nach Start/Wechsel eines Spiels: Anzeige aufräumen, Statistik und beide Plätze sichern.
    private async Task AfterGameChanged()
    {
        showWin = false;
        sheet = Sheets.None;
        await Data.SaveStatsAsync();
        await Data.SaveAllSlotsAsync(session);
    }

    private async Task OnGameChanged()
    {
        if (!game.Solved)
        {
            await SaveGame();
            return;
        }

        today = await Browser.GetTodayAsync();
        if (session.HandleWin(today) is not { } result) return;

        newRecord = result.NewRecord;
        dailyStreakAfterWin = result.DailyStreak;
        await Data.SaveStatsAsync();
        await Data.SaveDailyAsync();
        await Data.SaveSlotAsync(session, session.ActiveSlot);   // gelöst -> Platz wird geleert
        showWin = true;
    }

    // Speichert nach jedem Zug (und regelmäßig die Zeit) den aktiven Platz im Browser.
    private async Task SaveGame()
    {
        if (game.HasCells && !game.Solved)
            await Data.SaveSlotAsync(session, session.ActiveSlot);
    }

    private void CloseSheet() => sheet = Sheets.None;

    private void OpenNewGameFromWin()
    {
        showWin = false;
        sheet = Sheets.NewGame;
    }

    private async Task ToggleTheme()
    {
        theme = theme == "dark" ? "light" : "dark";
        await Browser.SetThemeAsync(theme);
    }

    // ---- Tastatur (Desktop) ----------------------------------------------

    private async Task OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key.Length == 1 && e.Key[0] >= '1' && e.Key[0] <= '9')
            game.Enter(e.Key[0] - '0');
        else if (e.Key is "Backspace" or "Delete" or "0")
            game.Erase();
        else if (e.Key is "n" or "N")
            game.ToggleNotesMode();
        else
        {
            Move(e.Key);
            return;     // nur die Auswahl hat sich geändert, nichts zu speichern
        }

        await OnGameChanged();
    }

    private void Move(string key)
    {
        if (!key.StartsWith("Arrow")) return;

        if (game.Selected is null)
        {
            if (game.HasCells) game.Select(game.Cells[0]);
            return;
        }
        int r = game.Selected.Row, c = game.Selected.Col;
        switch (key)
        {
            case "ArrowUp":    r = Math.Max(0, r - 1); break;
            case "ArrowDown":  r = Math.Min(8, r + 1); break;
            case "ArrowLeft":  c = Math.Max(0, c - 1); break;
            case "ArrowRight": c = Math.Min(8, c + 1); break;
            default: return;
        }
        game.Select(game.Cells[r * 9 + c]);
    }

    public void Dispose() => selfReference?.Dispose();
}
