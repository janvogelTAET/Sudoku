@page "/"
@using SudokuWeb.Game
@implements IDisposable

<div class="app" tabindex="0" @onkeydown="OnKeyDown">
    <header>
        <h1><span class="heart">💜</span> Leanas Sudoku</h1>
        <div class="stats">
            <div class="chip">Zeit<b>@TimeText</b></div>
        </div>
    </header>

    <div class="toolbar">
        <select @bind="selectedDifficulty" aria-label="Schwierigkeit">
            <option value="@Difficulty.Einfach">😊 Einfach</option>
            <option value="@Difficulty.Mittel">🙂 Mittel</option>
            <option value="@Difficulty.Schwer">😤 Schwer</option>
            <option value="@Difficulty.Experte">🔥 Experte</option>
        </select>
        <button class="btn btn-check" @onclick="game.Check">Prüfen</button>
        <button class="btn btn-primary" @onclick="NewGame">Neues Spiel</button>
    </div>

    @if (game.LastCheckErrors is int errs && !game.Solved)
    {
        <div class="banner @(errs == 0 ? "ok" : "bad")">
            @(errs == 0
                ? "✓ Alles richtig so weit – weiter so!"
                : $"✗ Noch {errs} {(errs == 1 ? "Feld stimmt" : "Felder stimmen")} nicht")
        </div>
    }

    <div class="board">
        @foreach (var cell in game.Cells)
        {
            <div class="@CellClass(cell)"
                 data-r="@cell.Row" data-c="@cell.Col"
                 @onclick="() => game.Select(cell)">
                @if (cell.Value != 0)
                {
                    @cell.Value
                }
                else if (cell.Notes.Count > 0)
                {
                    <div class="notes">
                        @for (int n = 1; n <= 9; n++)
                        {
                            <span>@(cell.Notes.Contains(n) ? n.ToString() : "")</span>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="pad">
        @for (int n = 1; n <= 9; n++)
        {
            int num = n;
            <button class="num @(game.Remaining(num) <= 0 ? "done" : "")" @onclick="() => Enter(num)">
                @num<span class="left">@(game.Remaining(num) > 0 ? game.Remaining(num).ToString() : "")</span>
            </button>
        }
    </div>

    <div class="actions">
        <button class="act" @onclick="game.Undo">
            <svg viewBox="0 0 24 24"><path d="M3 7v6h6"/><path d="M3 13a9 9 0 1 0 3-7L3 9"/></svg>
            Rückgängig
        </button>
        <button class="act" @onclick="game.Erase">
            <svg viewBox="0 0 24 24"><path d="M3 16l7 7h9l4-4-13-13-7 7z"/><path d="M14 7l4 4"/></svg>
            Löschen
        </button>
        <button class="act @(game.NotesMode ? "on" : "")" @onclick="game.ToggleNotesMode">
            <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
            Notizen
        </button>
        <button class="act" @onclick="game.Hint">
            <svg viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12c.7.7 1 1.3 1 2h6c0-.7.3-1.3 1-2a7 7 0 0 0-4-12z"/></svg>
            Tipp
        </button>
    </div>
</div>

<div class="credit">Für Leana 💜 · viel Spaß beim Rätseln</div>

@if (game.Solved)
{
    <div class="overlay show">
        <div class="card">
            <div class="big">🎉</div>
            <h2>Geschafft!</h2>
            <p>Gelöst in @TimeText. Stark gemacht! 💪</p>
            <button class="btn btn-primary" style="width:100%" @onclick="NewGame">Nochmal spielen</button>
        </div>
    </div>
}

@code {
    private readonly SudokuGame game = new();
    private Difficulty selectedDifficulty = Difficulty.Einfach;
    private System.Threading.Timer? timer;

    private string TimeText => $"{game.Seconds / 60}:{game.Seconds % 60:00}";

    protected override void OnInitialized()
    {
        game.NewGame(selectedDifficulty);
        timer = new System.Threading.Timer(_ =>
        {
            if (!game.Solved)
            {
                game.Seconds++;
                InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    private void NewGame() => game.NewGame(selectedDifficulty);

    private void Enter(int number) => game.Enter(number);

    private void OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key.Length == 1 && e.Key[0] >= '1' && e.Key[0] <= '9')
            game.Enter(e.Key[0] - '0');
        else if (e.Key is "Backspace" or "Delete" or "0")
            game.Erase();
        else
            Move(e.Key);
    }

    private void Move(string key)
    {
        if (game.Selected is null)
        {
            if (game.Cells.Length > 0) game.Select(game.Cells[0]);
            return;
        }
        int r = game.Selected.Row, c = game.Selected.Col;
        switch (key)
        {
            case "ArrowUp":    r = Math.Max(0, r - 1); break;
            case "ArrowDown":  r = Math.Min(8, r + 1); break;
            case "ArrowLeft":  c = Math.Max(0, c - 1); break;
            case "ArrowRight": c = Math.Min(8, c + 1); break;
            default: return;
        }
        game.Select(game.Cells[r * 9 + c]);
    }

    private string CellClass(SudokuCell cell)
    {
        var sel = game.Selected;
        var classes = new List<string> { "cell" };

        if (cell.IsFixed) classes.Add("fixed");
        if (sel is not null)
        {
            if (cell == sel) classes.Add("sel");
            else if (cell.Row == sel.Row || cell.Col == sel.Col || cell.Box == sel.Box) classes.Add("peer");
            if (sel.Value != 0 && cell.Value == sel.Value) classes.Add("same");
        }
        if (game.ErrorsVisible && cell.IsWrong) classes.Add("wrong");
        return string.Join(' ', classes);
    }

    public void Dispose() => timer?.Dispose();
}
