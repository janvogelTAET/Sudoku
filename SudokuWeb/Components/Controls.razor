@* Zahlen-Tastatur (mit Rest-Anzeige) und die Aktions-Leiste. *@
<div class="pad @(Game.NotesMode ? "notes-on" : "")">
    @for (int n = 1; n <= 9; n++)
    {
        int num = n;
        int left = Game.Remaining(num);
        <button class="num @(left <= 0 ? "done" : "")" disabled="@(left <= 0)" aria-label="@num"
                @onclick="() => Do(() => Game.Enter(num))">
            @num<span class="left">@(left > 0 ? left.ToString() : "")</span>
        </button>
    }
    <button class="num erase" aria-label="Löschen" @onclick="() => Do(Game.Erase)">
        <svg viewBox="0 0 24 24"><path d="M21 5H9l-6 7 6 7h12z"/><path d="M17 9.5l-5 5M12 9.5l5 5"/></svg>
    </button>
</div>

<div class="actions">
    <button class="act" disabled="@(!Game.CanUndo)" @onclick="() => Do(Game.Undo)">
        <svg viewBox="0 0 24 24"><path d="M3 7v6h6"/><path d="M3 13a9 9 0 1 0 3-7L3 9"/></svg>
        Zurück
    </button>
    <button class="act @(Game.NotesMode ? "on" : "")" aria-pressed="@Game.NotesMode" @onclick="() => Do(Game.ToggleNotesMode)">
        <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
        Notizen
    </button>
    <button class="act" @onclick="() => Do(Game.Hint)">
        <svg viewBox="0 0 24 24"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12c.7.7 1 1.3 1 2h6c0-.7.3-1.3 1-2a7 7 0 0 0-4-12z"/></svg>
        Tipp
    </button>
    <button class="act check" @onclick="() => Do(Game.Check)">
        <svg viewBox="0 0 24 24"><path d="M4 12.5l5 5L20 6.5"/></svg>
        Prüfen
    </button>
</div>

@code {
    [Parameter, EditorRequired] public SudokuGame Game { get; set; } = default!;

    /// <summary>Wird nach jeder Änderung am Spiel aufgerufen (zum Speichern und Neuzeichnen).</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private Task Do(Action action)
    {
        action();
        return OnChanged.InvokeAsync();
    }
}
