@implements IDisposable

@* Eigene Komponente, damit nur die Uhr jede Sekunde neu gezeichnet wird und nicht das ganze Spielfeld. *@
<button class="clock @(UserPaused ? "paused" : "")" aria-label="@(UserPaused ? "Weiter" : "Pause")" @onclick="OnToggle">
    @(UserPaused ? "⏸" : "⏱") @GameText.Time(Game.Seconds)
</button>

@code {
    private System.Threading.Timer? timer;

    [Parameter, EditorRequired] public SudokuGame Game { get; set; } = default!;
    [Parameter] public bool Paused { get; set; }

    /// <summary>Hat die Spielerin die Pause selbst angetippt? (nur für die Anzeige)</summary>
    [Parameter] public bool UserPaused { get; set; }

    /// <summary>Tippen auf die Uhr schaltet die Pause um.</summary>
    [Parameter] public EventCallback OnToggle { get; set; }

    /// <summary>Wird alle paar Sekunden aufgerufen, damit der Spielstand (Zeit) gespeichert werden kann.</summary>
    [Parameter] public Func<Task>? OnAutoSave { get; set; }

    protected override void OnInitialized()
        => timer = new System.Threading.Timer(_ => InvokeAsync(Tick), null, 1000, 1000);

    private async Task Tick()
    {
        if (Paused || !Game.HasCells || Game.Solved) return;

        Game.Seconds++;
        StateHasChanged();

        if (Game.Seconds % 5 == 0 && OnAutoSave is not null)
            await OnAutoSave();
    }

    public void Dispose() => timer?.Dispose();
}
