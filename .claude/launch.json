{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sudoku-web",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "SudokuWeb",
        "--urls",
        "http://localhost:5599"
      ],
      "port": 5599
    },
    {
      "name": "docs-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5610",
        "--directory",
        "docs"
      ],
      "port": 5610
    }
  ]
}